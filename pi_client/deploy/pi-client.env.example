# Pi 클라이언트 설정. 이 파일을 pi-client.env로 복사해서 값을 채운다(install.sh가 처음 한 번 복사해 준다).
#   cp pi_client/deploy/pi-client.env.example pi_client/deploy/pi-client.env
# 기기 키가 들어 있으므로 저장소에 올리지 말고, 권한은 600(본인만 읽기)으로 둔다.
# systemd 형식: '이름=값' 한 줄에 하나. 값에 따옴표는 필요 없다.
# 주의: 숫자 항목(PI_DEVICE_ID, PI_CAMERA_INDEX, PI_FPS, PI_RECORD_SECONDS)과 PI_PROMPT_WAV는 '이름='처럼
# 빈 값으로 두면 안 된다(빈 값도 값으로 읽힌다). 기본값을 쓰려면 줄 앞에 #을 붙여 주석으로 둔다.

# ---------------------------------------------------------------- 서버 접속
# 중앙 서버 주소. 시연은 https(mkcert 인증서). http는 장비 없이 시험할 때만 쓴다.
PI_SERVER_URL=https://192.168.0.10:8443
# 웹 마이페이지 → 내 기기 → 'Pi 기기 추가'에서 받은 기기 ID(숫자)와 기기 키.
# 기기 키는 추가할 때 한 번만 보인다. 잃어버리면 기기를 지우고 다시 추가한다.
PI_DEVICE_ID=0
PI_DEVICE_KEY=
# mkcert로 만든 인증서를 쓰면 그 인증 기관 파일(rootCA.pem) 경로. install.sh가 시스템과 Chromium에도 설치한다.
# 공인 인증서를 쓰거나 http로 시험하면 비워 둔다. 예) PI_CA_FILE=/home/pi/rootCA.pem
PI_CA_FILE=

# ---------------------------------------------------------------- 카메라
# auto(기본): 카메라 모듈(picamera2)을 먼저 찾고 없으면 USB 웹캠(OpenCV).
# picamera2 | opencv | file(시험용 영상 파일) | fake(장비 없는 시험 전용)
PI_CAMERA=auto
# opencv일 때 웹캠 번호(/dev/video0 → 0).
PI_CAMERA_INDEX=0
# file일 때 반복 재생할 영상 파일 경로.
PI_VIDEO_PATH=
# 초당 보낼 프레임 수. 서버 판정 기준이 약 10장이다. 네트워크가 느리면 낮춘다.
PI_FPS=10

# ---------------------------------------------------------------- 음성 확인
# sounddevice(기본, 실제 스피커·마이크) | fake(장비 없는 시험 전용)
PI_AUDIO=sounddevice
# 낙상 의심 때 재생할 안내 음성(16kHz 모노 wav 권장). 기본은 pi_client/assets/ask_status.wav.
#PI_PROMPT_WAV=/home/pi/elderly_fall_detection_pi_client/pi_client/assets/ask_status.wav
# 안내 음성이 끝난 뒤 녹음할 시간(초). 서버의 응답 대기 시간(FALL_VOICE_TIMEOUT, 기본 20초)보다 짧아야 한다.
PI_RECORD_SECONDS=5
# 마이크·스피커 장치 이름(일부만 써도 됨) 또는 번호. 비우면 기본 장치.
# 목록 보기: .venv/bin/python -m sounddevice
# 예) PI_INPUT_DEVICE=USB PnP Sound Device    PI_OUTPUT_DEVICE=1
# USB 장치(hw:N,0)는 클라이언트가 PA_ALSA_PLUGHW=1로 plughw로 열어 16kHz로 바꿔 받는다(목록 이름도 plughw로 보인다).
# 마이크를 다시 꽂으면 다음 녹음 실패 때 장치 목록을 새로 읽으므로 서비스를 다시 시작하지 않아도 된다.
PI_INPUT_DEVICE=
PI_OUTPUT_DEVICE=
