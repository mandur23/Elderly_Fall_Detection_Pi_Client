# Pi 현장 단말 클라이언트: 카메라 프레임 전송, 서버 요청 시 음성 확인(안내 음성 재생 → 녹음 → 업로드).
# install.sh가 경로·사용자를 이 Pi에 맞게 바꿔 /etc/systemd/system/에 복사한다.
#   상태 보기: systemctl status pi-client     로그 보기: journalctl -u pi-client -f
[Unit]
Description=Fall detection Pi client (camera stream, voice check)
# 부팅 직후 네트워크가 잡히기 전에 시작하면 첫 접속이 실패하므로 기다린다(실패해도 클라이언트가 재접속한다).
Wants=network-online.target
After=network-online.target sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/elderly_fall_detection_pi_client
# 기기 ID·기기 키·서버 주소. 파일이 없으면 시작하지 않는다('-'를 붙이지 않은 이유).
EnvironmentFile=/home/pi/elderly_fall_detection_pi_client/pi_client/deploy/pi-client.env
Environment=PYTHONUNBUFFERED=1
# Bookworm의 기본 소리 장치(PipeWire)는 로그인한 사용자 세션에 붙어 있다.
# 시스템 서비스에서도 그 장치를 쓰도록 사용자 런타임 폴더를 알려 준다(install.sh가 실제 uid로 바꾼다).
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/pi/elderly_fall_detection_pi_client/.venv/bin/python -m pi_client
# 예기치 않게 죽으면 5초 뒤 다시 시작한다. 서버가 꺼진 경우는 클라이언트가 스스로 재접속하므로 여기까지 오지 않는다.
Restart=on-failure
RestartSec=5
# 다시 시작해도 소용없는 종료 코드는 재시작하지 않는다(재시작하면 같은 오류로 무한 반복된다).
#   2 = 설정 누락(PI_DEVICE_ID·PI_DEVICE_KEY)        -> pi-client.env를 고친다
#   3 = 서버가 거부(4401 기기 키 오류, 4403 권한 없음) -> 마이페이지에서 기기 키 확인
#   4 = 같은 기기로 다른 클라이언트가 접속함(4409)     -> 클라이언트가 두 개 떠 있는지 확인
# 고친 뒤에는 sudo systemctl restart pi-client 로 다시 시작한다.
RestartPreventExitStatus=2 3 4
# SIGTERM을 받으면 진행 중인 음성 확인을 정리하고 끝난다. 녹음(최대 수 초) 중이어도 넉넉한 시간.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
